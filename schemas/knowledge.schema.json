{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Structured Anarchy knowledge base, version 1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "sources", "sessions", "symbols", "meanings", "propositions", "arguments", "occurrences", "questions"],
  "properties": {
    "schema_version": {"const": 1},
    "sources": {"type": "array", "items": {"$ref": "#/$defs/source"}},
    "sessions": {"type": "array", "items": {"$ref": "#/$defs/session"}},
    "symbols": {"type": "array", "items": {"$ref": "#/$defs/symbol"}},
    "meanings": {"type": "array", "items": {"$ref": "#/$defs/meaning"}},
    "propositions": {"type": "array", "items": {"$ref": "#/$defs/proposition"}},
    "arguments": {"type": "array", "items": {"$ref": "#/$defs/argument"}},
    "occurrences": {"type": "array", "items": {"$ref": "#/$defs/occurrence"}},
    "questions": {"type": "array", "items": {"$ref": "#/$defs/question"}}
  },
  "$defs": {
    "id": {"type": "string", "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$", "maxLength": 100},
    "text": {"type": "string", "minLength": 1, "pattern": "\\S"},
    "ids": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/id"}},
    "origin": {
      "type": "object", "additionalProperties": false,
      "required": ["file_name", "start_char", "stop_char", "first_6_chars", "last_6_chars"],
      "properties": {
        "file_name": {"$ref": "#/$defs/text"},
        "start_char": {"type": "integer", "minimum": 0},
        "stop_char": {"type": "integer", "minimum": 1},
        "first_6_chars": {"type": "string", "minLength": 1, "maxLength": 6},
        "last_6_chars": {"type": "string", "minLength": 1, "maxLength": 6}
      }
    },
    "origins": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/origin"}},
    "optionalOrigins": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/origin"}},
    "induction": {
      "type": "object", "additionalProperties": false,
      "required": ["rationale", "argument_ids", "context_origins"],
      "properties": {
        "rationale": {"$ref": "#/$defs/text"},
        "argument_ids": {"allOf": [{"$ref": "#/$defs/ids"}], "minItems": 1},
        "context_origins": {"$ref": "#/$defs/origins"}
      }
    },
    "source": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "file_name", "sha256", "label"],
      "properties": {
        "id": {"$ref": "#/$defs/id"}, "file_name": {"$ref": "#/$defs/text"},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "label": {"$ref": "#/$defs/text"}
      }
    },
    "session": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "title", "source_ids"],
      "properties": {
        "id": {"$ref": "#/$defs/id"}, "title": {"$ref": "#/$defs/text"},
        "source_ids": {"allOf": [{"$ref": "#/$defs/ids"}], "minItems": 1},
        "date": {"type": "string", "format": "date"},
        "location": {"$ref": "#/$defs/text"},
        "metadata_file": {"type": "string", "pattern": "^data/knowledge/sessions/[a-z0-9-]+\\.toml$"}
      }
    },
    "symbol": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "label", "aliases"],
      "properties": {
        "id": {"$ref": "#/$defs/id"}, "label": {"$ref": "#/$defs/text"},
        "aliases": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/text"}}
      }
    },
    "meaning": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "symbol_id", "kind", "definition", "origins"],
      "properties": {
        "id": {"$ref": "#/$defs/id"}, "symbol_id": {"$ref": "#/$defs/id"},
        "kind": {"enum": ["normative", "defined"]}, "definition": {"$ref": "#/$defs/text"},
        "origins": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/origin"}}
      },
      "allOf": [
        {"if": {"properties": {"kind": {"const": "defined"}}}, "then": {"properties": {"origins": {"minItems": 1}}}},
        {"if": {"properties": {"kind": {"const": "normative"}}}, "then": {"properties": {"definition": {"const": "Normative (undeclared)"}, "origins": {"maxItems": 0}}}}
      ]
    },
    "binding": {
      "type": "object", "additionalProperties": false,
      "required": ["start_char", "stop_char", "symbol_id", "meaning_ids", "excluded_meaning_ids", "selection", "origins"],
      "properties": {
        "start_char": {"type": "integer", "minimum": 0}, "stop_char": {"type": "integer", "minimum": 1},
        "symbol_id": {"$ref": "#/$defs/id"},
        "meaning_ids": {"allOf": [{"$ref": "#/$defs/ids"}], "minItems": 1},
        "excluded_meaning_ids": {"$ref": "#/$defs/ids"},
        "selection": {"enum": ["specified", "ambiguous", "collective"]},
        "origins": {"$ref": "#/$defs/optionalOrigins"}
      }
    },
    "proposition": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "text", "scope", "kind", "thesis", "topics", "origins", "bindings"],
      "properties": {
        "id": {"$ref": "#/$defs/id"}, "text": {"$ref": "#/$defs/text"},
        "scope": {"$ref": "#/$defs/text"},
        "kind": {"enum": ["empirical", "normative", "definitional"]}, "thesis": {"type": "boolean"},
        "topics": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/text"}},
        "origins": {"$ref": "#/$defs/optionalOrigins"},
        "evidence_status": {"enum": ["sourced", "induced"]},
        "induction": {"$ref": "#/$defs/induction"},
        "bindings": {"type": "array", "items": {"$ref": "#/$defs/binding"}}
      },
      "allOf": [{
        "if": {"required": ["evidence_status"], "properties": {"evidence_status": {"const": "induced"}}},
        "then": {"required": ["induction"], "properties": {"origins": {"maxItems": 0}}},
        "else": {"properties": {"origins": {"minItems": 1}}}
      }]
    },
    "literal": {
      "type": "object", "additionalProperties": false,
      "required": ["proposition_id", "negated", "origins"],
      "properties": {
        "proposition_id": {"$ref": "#/$defs/id"}, "negated": {"type": "boolean"}, "origins": {"$ref": "#/$defs/optionalOrigins"}
      }
    },
    "argument": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "premises", "conclusion", "explicitness", "explanation", "origins"],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "premises": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/literal"}},
        "conclusion": {"$ref": "#/$defs/literal"},
        "explicitness": {"enum": ["explicit", "reconstructed"]},
        "explanation": {"$ref": "#/$defs/text"}, "origins": {"$ref": "#/$defs/origins"}
      }
    },
    "occurrence": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "session_id", "target_type", "target_id", "stance", "origins"],
      "properties": {
        "id": {"$ref": "#/$defs/id"}, "session_id": {"$ref": "#/$defs/id"},
        "target_type": {"enum": ["proposition", "argument", "meaning"]}, "target_id": {"$ref": "#/$defs/id"},
        "stance": {"enum": ["asserted", "questioned", "rejected", "hypothetical", "withdrawn"]},
        "attribution": {"$ref": "#/$defs/text"}, "origins": {"$ref": "#/$defs/origins"}
      }
    },
    "question": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "text", "proposition_ids", "symbol_ids", "origins"],
      "properties": {
        "id": {"$ref": "#/$defs/id"}, "text": {"$ref": "#/$defs/text"},
        "origin_kind": {"enum": ["session", "extraction_review"]},
        "session_id": {"$ref": "#/$defs/id"},
        "proposition_ids": {"$ref": "#/$defs/ids"}, "symbol_ids": {"$ref": "#/$defs/ids"}, "origins": {"$ref": "#/$defs/origins"}
      },
      "allOf": [{
        "if": {"required": ["origin_kind"], "properties": {"origin_kind": {"const": "session"}}},
        "then": {"required": ["session_id"]}
      }]
    }
  }
}
